//! QuakeC system globals, fields and builtins, named as in @TITLE@'s
//! `@DEFS_FILE@`@HEADER_EXTRA@.
//!
//! Generated by `zig-qc init --target @TARGET@`, from the converter's
//! description of the target (`src/sysdefs.rs`).
//!
//! Each global lives at `slot * 4` in linear memory, which wasm-to-qc maps
//! back onto the QuakeC global with the same name.

const std = @import("std");

/// Tells the converter to use the @TITLE@ system defs.
pub export const __quakec_target: [@TARGET_LEN@:0]u8 = "@TARGET@".*;

/// The @TITLE@ system entity fields (`entvars_t`), named as in
/// `@DEFS_FILE@`. Each value is the field's QuakeC field offset, which is
/// what the field intrinsics below pass to the converter. Vector fields take
/// up three slots; access their components through the `Vector` instead.
pub const Field = enum(u32) {
@FIELD_ENUM@

    pub fn Type(comptime this: @This()) type {
        return switch (this) {
@FIELD_TYPES@
        };
    }
};

/// A QuakeC `entity`: a pointer to its system fields (`entvars_t`), so they
/// can be used directly, e.g. `self.health -= 1` or `e.origin[2] += 8`.
/// Each field is at byte offset `4 *` its `Field` offset (checked by a test
/// below). Vector fields are `[3]f32`, which coerces to and from `Vector`:
/// `const v: Vector = e.origin;`, `e.origin = v;`.
///
/// Entities are never real memory: the converter turns loads and stores
/// through an `Entity` into QuakeC field accesses. Only use fields through
/// the pointer, and don't keep pointers to fields (`&e.health`). User fields
/// (see `userField`) aren't in the struct: use `get` and `set`, which also
/// work for system fields.
///
/// `allowzero` because `world` is entity 0.
pub const Entity = *allowzero extern struct {
@ENTITY_FIELDS@

    // `inline` so that `field` reaches the intrinsic as a constant; the
    // converter needs it to be a compile-time constant. `field` is a `Field`
    // (e.g. `.health`) or a `UserField` (see `userField`).
    pub inline fn get(this: Entity, comptime field: anytype) FieldType(field) {
        const offset = fieldOffset(field);
        return switch (FieldType(field)) {
            f32 => __quakec_load_entity_field_float(this, offset),
            Vector => __quakec_load_entity_field_vector(this, offset),
            String => __quakec_load_entity_field_string(this, offset),
            Entity => __quakec_load_entity_field_entity(this, offset),
            ?Function => __quakec_load_entity_field_fn(this, offset),
            Function => @compileError("function fields are `?Function`: they can hold QuakeC's null function"),
            else => @compileError("unsupported field type " ++ @typeName(FieldType(field))),
        };
    }

    pub inline fn set(this: Entity, comptime field: anytype, value: FieldType(field)) void {
        const offset = fieldOffset(field);
        switch (FieldType(field)) {
            f32 => __quakec_store_entity_field_float(this, offset, value),
            Vector => __quakec_store_entity_field_vector(this, offset, value),
            String => __quakec_store_entity_field_string(this, offset, value),
            Entity => __quakec_store_entity_field_entity(this, offset, value),
            ?Function => __quakec_store_entity_field_fn(this, offset, value),
            Function => @compileError("function fields are `?Function`: they can hold QuakeC's null function"),
            else => @compileError("unsupported field type " ++ @typeName(FieldType(field))),
        }
    }

    /// `a == b` (`EQ_E`).
    pub inline fn eql(a: Entity, b: Entity) bool {
        return __quakec_eq_entity(a, b);
    }

    /// `a != b` (`NE_E`).
    pub inline fn neq(a: Entity, b: Entity) bool {
        return __quakec_ne_entity(a, b);
    }

    /// `!e` (`NOT_ENT`): whether this is `world`/null.
    pub inline fn isNull(this: Entity) bool {
        return __quakec_not_entity(this);
    }
};

/// A QuakeC `string`: an opaque handle, which the converter infers from the
/// intrinsics, builtins and fields it is used with.
pub const String = enum(u32) {
    _,

    const Self = @This();

    /// `a == b` (`EQ_S`), comparing contents.
    pub inline fn eql(a: Self, b: Self) bool {
        return __quakec_eq_string(a, b);
    }

    /// `a != b` (`NE_S`), comparing contents.
    pub inline fn neq(a: Self, b: Self) bool {
        return __quakec_ne_string(a, b);
    }

    /// `!s` (`NOT_S`): whether this is null or empty.
    pub inline fn isNull(this: Self) bool {
        return __quakec_not_string(this);
    }

    /// A string literal, e.g. `String.lit("progs/player.mdl")`. The bytes
    /// are placed in static data (NUL-terminated) and the converter emits a
    /// QuakeC `"..."`.
    pub inline fn lit(comptime s: []const u8) String {
        if (!NoNul(s).ok) @compileError("QuakeC strings can't contain NUL bytes");
        const z = comptime (s ++ "\x00")[0..s.len :0];
        return __quakec_string_literal(z);
    }
};

/// Checked in a container so that the check gets its own branch quota, rather than
/// adding to that of the function using the literal.
fn NoNul(comptime s: []const u8) type {
    return struct {
        const ok = blk: {
            @setEvalBranchQuota(s.len * 4 + 1000);
            break :blk std.mem.indexOfScalar(u8, s, 0) == null;
        };
    };
}

comptime {
    if (Entity == String) unreachable;
}

/// A QuakeC `vector`. With simd128 enabled this is passed as a `v128`.
pub const Vector = @Vector(3, f32);

/// A QuakeC function value (`void()`), as stored in globals and fields. In
/// wasm this is a plain function pointer (a table index); the converter
/// turns it back into a QuakeC function.
///
/// Function fields are `?Function`: they can hold QuakeC's null function
/// (`__NULL__`, function 0), which is only a "no function" sentinel. The
/// engine and the VM both refuse to call it, so call a field with
/// `self.think.?()` after checking it, as QuakeC code does.
pub const Function = *const fn () callconv(.c) void;

/// A user-defined entity field `.T name`, which the converter declares. See
/// `userField`.
pub fn UserField(comptime T: type) type {
    return struct {
        pub const Type = T;
        pub const user_decl_prefix = "__quakec_field:";
        name: [*:0]const u8,
    };
}

/// Declare a user entity field, e.g.
/// `pub const attack_finished = defs.userField(f32, "attack_finished");`,
/// then use it like a system field: `e.get(attack_finished)`.
pub fn userField(comptime T: type, comptime name: [:0]const u8) UserField(T) {
    return .{ .name = name.ptr };
}

fn isSysField(comptime F: type) bool {
    return F == Field or F == @TypeOf(.enum_literal);
}

/// The type of a system or user field.
pub fn FieldType(comptime field: anytype) type {
    return if (comptime isSysField(@TypeOf(field))) @as(Field, field).Type() else @TypeOf(field).Type;
}

/// System fields are passed to the intrinsics as their offset, user fields
/// as the address of their name in static data.
inline fn fieldOffset(comptime field: anytype) u32 {
    return if (comptime isSysField(@TypeOf(field))) @backingInt(@as(Field, field)) else @intFromPtr(field.name);
}

/// A Zig function as a QuakeC function value, e.g.
/// `e.set(.think, defs.func(SUB_Remove))`. The function must use the C
/// calling convention. Functions taking parameters can be stored too, and
/// called with `callAs`.
pub inline fn func(comptime f: anytype) Function {
    return @ptrCast(&f);
}

/// View a function value as a function of type `F` (e.g.
/// `fn (Entity, f32) callconv(.c) void`) so that it can be called.
pub inline fn callAs(comptime F: type, f: Function) *const F {
    return @ptrCast(f);
}

/// `a == b` (`EQ_FNC`).
pub inline fn fnEql(a: ?Function, b: ?Function) bool {
    return __quakec_eq_fn(a, b);
}

/// `a != b` (`NE_FNC`).
pub inline fn fnNeq(a: ?Function, b: ?Function) bool {
    return __quakec_ne_fn(a, b);
}

/// `!f` (`NOT_FNC`): whether this is the null function.
pub inline fn fnIsNull(f: ?Function) bool {
    return __quakec_not_fn(f);
}

/// `a == b` on vectors (`EQ_V`). Written as an intrinsic so that LLVM can't
/// turn it into SIMD comparisons QuakeC doesn't have.
pub inline fn vecEql(a: Vector, b: Vector) bool {
    return __quakec_eq_vector(a, b);
}

/// `a != b` on vectors (`NE_V`).
pub inline fn vecNeq(a: Vector, b: Vector) bool {
    return __quakec_ne_vector(a, b);
}

/// `!v` (`NOT_V`): whether this is `'0 0 0'`.
pub inline fn vecIsZero(v: Vector) bool {
    return __quakec_not_vector(v);
}

/// `a * b` on vectors (`MUL_V`): the dot product.
pub inline fn vecDot(a: Vector, b: Vector) f32 {
    return __quakec_dot_vector(a, b);
}

extern fn __quakec_eq_vector(a: Vector, b: Vector) bool;
extern fn __quakec_ne_vector(a: Vector, b: Vector) bool;
extern fn __quakec_not_vector(v: Vector) bool;
extern fn __quakec_dot_vector(a: Vector, b: Vector) f32;

extern fn __quakec_field_ref_string(field: u32) Field;
extern fn __quakec_eq_fn(a: ?Function, b: ?Function) bool;
extern fn __quakec_ne_fn(a: ?Function, b: ?Function) bool;
extern fn __quakec_not_fn(f: ?Function) bool;

// Entity field access. `field` is the field's offset (see `Field`), and must
// be a compile-time constant. There is one intrinsic per type so the
// converter can emit the correctly-typed load/store instruction.
extern fn __quakec_load_entity_field_float(ent: Entity, field: u32) f32;
extern fn __quakec_load_entity_field_vector(ent: Entity, field: u32) Vector;
extern fn __quakec_load_entity_field_string(ent: Entity, field: u32) String;
extern fn __quakec_load_entity_field_entity(ent: Entity, field: u32) Entity;
extern fn __quakec_load_entity_field_fn(ent: Entity, field: u32) ?Function;

extern fn __quakec_store_entity_field_float(ent: Entity, field: u32, value: f32) void;
extern fn __quakec_store_entity_field_vector(ent: Entity, field: u32, value: Vector) void;
extern fn __quakec_store_entity_field_string(ent: Entity, field: u32, value: String) void;
extern fn __quakec_store_entity_field_entity(ent: Entity, field: u32, value: Entity) void;
extern fn __quakec_store_entity_field_fn(ent: Entity, field: u32, value: ?Function) void;

// Comparisons. The handles are opaque, and QuakeC needs the type to pick the
// right opcode.
extern fn __quakec_eq_entity(a: Entity, b: Entity) bool;
extern fn __quakec_ne_entity(a: Entity, b: Entity) bool;
extern fn __quakec_not_entity(e: Entity) bool;
extern fn __quakec_eq_string(a: String, b: String) bool;
extern fn __quakec_ne_string(a: String, b: String) bool;
extern fn __quakec_not_string(s: String) bool;

// A string literal. `ptr` must be the constant address of a NUL-terminated
// string in static data; the converter reads it and emits a QuakeC literal.
extern fn __quakec_string_literal(ptr: [*:0]const u8) String;

// Globals. `ptr` is `slot * 4` for system globals, or the address of the
// name of a user global (see `userGlobal`).
extern fn __quakec_load_float(ptr: *const anyopaque) f32;
extern fn __quakec_load_vector(ptr: *const anyopaque) Vector;
extern fn __quakec_load_entity(ptr: *const anyopaque) Entity;
extern fn __quakec_load_string(ptr: *const anyopaque) String;
extern fn __quakec_load_fn(ptr: *const anyopaque) Function;

extern fn __quakec_store_float(ptr: *const anyopaque, value: f32) void;
extern fn __quakec_store_vector(ptr: *const anyopaque, value: Vector) void;
extern fn __quakec_store_entity(ptr: *const anyopaque, ent: Entity) void;
extern fn __quakec_store_string(ptr: *const anyopaque, ent: String) void;
extern fn __quakec_store_fn(ptr: *const anyopaque, value: Function) void;

/// A QuakeC global of type `T`: `f32` (or an integer or `bool`, stored as a
/// float), `Vector`, `Entity`, `String`, or a function type.
pub fn Global(comptime T: type) type {
    const Ty = switch (@typeInfo(T)) {
        .@"fn" => *const T,
        else => T,
    };

    return struct {
        const Self = @This();
        pub const Type = T;
        pub const user_decl_prefix = "__quakec_global:";

        ptr: *const anyopaque,
        /// The name of a user global (see `userGlobal`); null for system
        /// globals.
        user_name: ?[:0]const u8 = null,

        pub inline fn get(comptime this: Self) Ty {
            return switch (@typeInfo(T)) {
                .int => @intFromFloat(__quakec_load_float(this.ptr)),
                .float => @as(T, __quakec_load_float(this.ptr)),
                .bool => __quakec_load_float(this.ptr) != 0,
                .@"fn" => @ptrCast(__quakec_load_fn(this.ptr)),
                else => if (T == Entity)
                    __quakec_load_entity(this.ptr)
                else if (T == String)
                    __quakec_load_string(this.ptr)
                else if (T == Vector)
                    __quakec_load_vector(this.ptr)
                else
                    @compileError("unsupported global type " ++ @typeName(T)),
            };
        }

        pub inline fn set(comptime this: Self, value: Ty) void {
            switch (@typeInfo(T)) {
                .int => __quakec_store_float(this.ptr, @floatFromInt(value)),
                .float => __quakec_store_float(this.ptr, value),
                .bool => __quakec_store_float(this.ptr, if (value) 1 else 0),
                .@"fn" => __quakec_store_fn(this.ptr, @ptrCast(value)),
                else => if (T == Entity)
                    __quakec_store_entity(this.ptr, value)
                else if (T == String)
                    __quakec_store_string(this.ptr, value)
                else if (T == Vector)
                    __quakec_store_vector(this.ptr, value)
                else
                    @compileError("unsupported global type " ++ @typeName(T)),
            }
        }
    };
}

/// A system global at `slot`.
pub fn global(comptime T: type, comptime slot: comptime_int) Global(T) {
    return .{ .ptr = @ptrFromInt(slot * 4) };
}

/// Declare a user global, e.g.
/// `pub const activator = defs.userGlobal(Entity, "activator");`. The
/// converter declares it in the QuakeC output. Zig `var`s can't be used.
pub fn userGlobal(comptime T: type, comptime name: [:0]const u8) Global(T) {
    return .{ .ptr = name.ptr, .user_name = name };
}

/// Declare every `userField` and `userGlobal` that `module` defines, even
/// ones that no code uses, as QuakeC does for everything in its sources
/// (maps and savegames can set fields that the code never reads). Call it
/// at comptime for each of the project's modules, e.g. from the root file:
/// `comptime { defs.declareUserDefs(@import("game.zig")); }`.
pub fn declareUserDefs(comptime module: type) void {
    @setEvalBranchQuota(1_000_000);
    inline for (@typeInfo(module).@"struct".decl_names) |d| {
        const V = @TypeOf(@field(module, d));
        if (@typeInfo(V) != .@"struct" or !@hasDecl(V, "user_decl_prefix")) continue;
        const v = @field(module, d);
        const name: [:0]const u8 = comptime if (@hasField(V, "user_name"))
            v.user_name orelse continue
        else
            std.mem.span(v.name);
        // The converter only looks at the export's name.
        @export(&declared_marker, .{ .name = V.user_decl_prefix ++ userDeclType(V.Type) ++ ":" ++ name });
    }
}

const declared_marker: u8 = 0;

fn userDeclType(comptime T: type) []const u8 {
    if (T == Vector) return "vector";
    if (T == String) return "string";
    if (T == Entity) return "entity";
    if (T == Function or T == ?Function) return "function";
    return switch (@typeInfo(T)) {
        .float, .int, .bool => "float",
        .@"fn" => "function",
        else => @compileError("unsupported user global or field type " ++ @typeName(T)),
    };
}

// ---- system globals (@TITLE@ `globalvars_t`) ----

@GLOBALS@

// ---- builtins (@TITLE@) ----

pub fn find(start: Entity, comptime fld: Field, match: String) Entity {
    if (fld.Type() != String) @compileError("only `.string` field references are supported");
    return find_mod.find(start, __quakec_field_ref_string(@backingInt(fld)), match);
}

@BUILTINS@

@TAIL@// ============================================================================
//
// Helpers for QuakeC idioms, used by the port.
//
// ============================================================================

/// A string literal.
pub const S = String.lit;

/// `a & b` on QuakeC floats (`OP_BITAND`).
pub inline fn band(a: f32, b: f32) f32 {
    return @floatFromInt(@as(i32, @intFromFloat(a)) & @as(i32, @intFromFloat(b)));
}

/// `a | b` on QuakeC floats (`OP_BITOR`).
pub inline fn bor(a: f32, b: f32) f32 {
    return @floatFromInt(@as(i32, @intFromFloat(a)) | @as(i32, @intFromFloat(b)));
}

/// Whether any of the bits of `b` are set in `a`: `if (a & b)`.
pub inline fn has(a: f32, b: f32) bool {
    return band(a, b) != 0;
}

/// A vector `'x y z'`.
pub inline fn vec(x: f32, y: f32, z: f32) Vector {
    return .{ x, y, z };
}

/// `v * f` for a vector `v` and a float `f`.
pub inline fn scale(v: Vector, f: f32) Vector {
    return v * @as(Vector, @splat(f));
}

/// `a * b` for two vectors: the dot product.
pub inline fn dot(a: Vector, b: Vector) f32 {
    return vecDot(a, b);
}

/// `a == b` for vectors.
pub inline fn veq(a: Vector, b: Vector) bool {
    return vecEql(a, b);
}

/// `if (v)` for a vector.
pub inline fn vtrue(v: Vector) bool {
    return !vecIsZero(v);
}

/// `self`, as an entity.
pub inline fn me() Entity {
    return self.get();
}

/// The `[frame, nextthink]` prefix of a QuakeC state function:
/// `void() f = [$frame, next] { ... };`.
pub inline fn setState(frame: f32, next: Function) void {
    const e = self.get();
    e.set(.frame, frame);
    e.set(.nextthink, time.get() + 0.1);
    e.set(.think, next);
}

// The layout only holds on wasm32 (4-byte pointers): run with
// `zig test src/defs.zig -target wasm32-wasi --test-cmd wasmtime --test-cmd-bin`.
test "entity fields match Field" {
    if (@sizeOf(usize) != 4) return error.SkipZigTest;
    const Fields = @typeInfo(Entity).pointer.child;
    const names = @typeInfo(Fields).@"struct".field_names;
    const variants = @typeInfo(Field).@"enum";
    try std.testing.expectEqual(variants.field_names.len, names.len);
    inline for (variants.field_names, variants.field_values) |name, value| {
        const field: Field = @fromBackingInt(@intCast(value));
        const T = @FieldType(Fields, name);
        try std.testing.expectEqual(@backingInt(field) * 4, @offsetOf(Fields, name));
        if (field.Type() == Vector) {
            try std.testing.expectEqual([3]f32, T);
        } else {
            try std.testing.expectEqual(field.Type(), T);
            try std.testing.expectEqual(4, @sizeOf(T));
        }
    }
}

test "float bit operations" {
    try std.testing.expectEqual(@as(f32, 512), band(512 + 8, 512));
    try std.testing.expectEqual(@as(f32, 520), bor(512, 8));
    try std.testing.expect(has(4096 + 1, 1));
    try std.testing.expect(!has(4096, 1));
}
